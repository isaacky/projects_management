# Copy to pmp.env (not committed) and fill in. Read by deploy.sh and build.sh as a shell file:
# put values that contain spaces in double quotes, for example PMP_ADMIN_NAME="Jane Doe".

# The address people use. DNS must point it at the Swarm manager (Traefik).
PMP_HOST=pmp.kplc.co.ke

# Images: built and pushed by build.sh. For a single-node Swarm, PMP_REGISTRY=pmp (local images).
PMP_REGISTRY=ghcr.io/isaacky
PMP_VERSION=0.1.0

# The organisation. Generate the id once (uuidgen) and never change it: Keycloak puts it in every
# token (tenant_id) and the backend creates the tenant with it on first start.
PMP_TENANT_ID=
PMP_TENANT_NAME="Kenya Power"
# The first system administrator: signs in with this email and adds everyone else.
PMP_ADMIN_EMAIL=
PMP_ADMIN_NAME=

# TLS: Let's Encrypt needs ports 80/443 reachable from the internet. For an internal-only host with
# a corporate certificate, see RUNBOOK.md (Certificates).
PMP_ACME_EMAIL=
PMP_TLS_DIR=/srv/pmp-tls

# Who may open the Keycloak admin console (CIDR list, comma-separated).
PMP_ADMIN_ALLOW_CIDR=10.0.0.0/8

# Backups (on the database and storage nodes). Mount a separate disk or network share here.
PMP_BACKUP_DIR=/srv/pmp-backups
PMP_BACKUP_HOUR=1
PMP_BACKUP_KEEP_DAYS=14

# Bump when a file under deploy/ (realm, scripts) changes, so Swarm picks up the new config.
PMP_CONFIG_VERSION=1
