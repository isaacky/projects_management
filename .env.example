# Copy to .env and change for anything other than your own laptop.
PMP_DB_USER=pmp
PMP_DB_PASSWORD=pmp
# S3 keys must match deploy/seaweedfs/s3.json
PMP_S3_ACCESS_KEY=pmp
PMP_S3_SECRET_KEY=pmp-secret-change-me
PMP_S3_BUCKET=pmp-documents
VITE_DEV_TENANT_ID=01920000-0000-7000-8000-000000000001

# Wraps every tender's bid-sealing key. Required outside the dev profile.
# Generate with: openssl rand -base64 32   (back it up: without it sealed bids cannot be opened)
PMP_SEALING_MASTER_KEY=
